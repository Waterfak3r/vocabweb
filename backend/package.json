{
  "name": "vacabweb-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dictionaries:build": "node scripts/build-dictionaries.mjs",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
