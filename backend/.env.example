# HTTP server port
PORT=3000

# Comma-separated browser origins allowed by CORS during development
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# WiktApi word endpoint and request timeout (maximum 5000 ms)
WIKTAPI_BASE_URL=https://api.wiktapi.dev/v1/en/word
WIKTAPI_TIMEOUT_MS=5000

# In-process successful word lookup cache
WORD_CACHE_TTL_MS=3600000
WORD_CACHE_MAX_ENTRIES=1000

# Per-IP, in-process rate limit for GET /api/words only
WORD_RATE_LIMIT_WINDOW_MS=60000
WORD_RATE_LIMIT_MAX_REQUESTS=60

# Number of reverse proxies (nginx, load balancer, ...) in front of the app.
# Required for correct per-IP rate limiting behind a proxy. Never use a blanket
# "trust everything" value; set the exact hop count (0 = no proxy).
TRUST_PROXY=0

# Durable anonymous catalog, wordbooks, and study events. Relative to backend/.
DATA_FILE=./data/study-state.json

# Built frontend directory to serve (static assets + SPA fallback for deep links).
# Empty = disabled (API only). Absolute or relative to the backend cwd. When set,
# the backend serves this directory and same-origin browser requests are allowed.
# Example (uncomment for a same-origin production deploy):
# STATIC_DIR=../frontend/dist
