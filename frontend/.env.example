# Optional: when set, non-local lookups use the vacabweb backend.
# "/" uses the Vite /api proxy in development and the same-origin backend in
# production. Leave empty/unset for local-only mode with no backend.
VITE_API_BASE=/

# Optional donation QR/image shown from the header. Empty shows a built-in placeholder.
VITE_DONATION_IMAGE_URL=
