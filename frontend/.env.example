# Optional: when set, non-local lookups use the vacabweb backend.
# Use an absolute URL for a separate backend (e.g. http://localhost:3000), or "/"
# for the production-style same-origin setup where the backend serves this build
# (see .env.production). Leave empty/unset for local-only mode with no backend.
VITE_API_BASE=http://localhost:3000
